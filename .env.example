# GEO Expression Service — copy to `.env` in repository root and adjust as needed.
# All GEO_* keys map to Settings in geo_expression_service/config.py (prefix GEO_).

# --- Cache (two-tier: in-memory LRU → disk under cache_dir) ---
GEO_CACHE_DIR=.cache/geo_expression
GEO_CACHE_MAX_ENTRIES=256
GEO_CACHE_MAX_BYTES=536870912

# --- NCBI HTTP (GeoClient: timeout, retries, bounded concurrency) ---
GEO_HTTP_TIMEOUT_S=120
GEO_HTTP_RETRY_COUNT=3
GEO_HTTP_RETRY_BACKOFF_S=1.0
GEO_CONCURRENCY_LIMIT=4

# --- Chat agent (stub LLM when key absent or GEO_STUB_LLM=true) ---
GEO_STUB_LLM=false
# OPENAI_API_KEY=sk-...
# GEO_OPENAI_API_KEY=sk-...
GEO_OPENAI_MODEL=gpt-4o-mini
